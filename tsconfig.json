{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "sourceMap": true
  },
  "include": ["scripts/**/*", "tests/**/*"],
  "exclude": ["dist", "node_modules"]
}
