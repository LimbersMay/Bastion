{
  "format_version": "1.8.0",
  "animations": {
    "animation.bastion.humanoid.walk": {
      "loop": true,
      "bones": {
        "rightarm": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 70.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leftarm": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 70.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "rightleg": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 80.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leftleg": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 80.0 * query.modified_move_speed",
            0,
            0
          ]
        }
      }
    },
    "animation.bastion.humanoid.attack": {
      "loop": true,
      "bones": {
        "rightarm": {
          "rotation": [
            "-70.0 - math.sin(variable.attack_time * 180.0) * 50.0",
            0,
            0
          ]
        }
      }
    },
    "animation.bastion.humanoid.aim": {
      "loop": true,
      "override_previous_animation": false,
      "bones": {
        "rightarm": {
          "rotation": [
            "query.target_x_rotation - 90.0",
            "query.target_y_rotation - 5.0",
            0.0
          ]
        },
        "leftarm": {
          "rotation": [
            "query.target_x_rotation - 90.0",
            "query.target_y_rotation + 38.0",
            0.0
          ]
        }
      }
    }
  }
}
