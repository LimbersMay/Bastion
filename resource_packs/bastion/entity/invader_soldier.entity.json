{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "bastion:invader_soldier",
      "materials": { "default": "entity_alphatest" },
      "textures": { "default": "textures/entity/invader_soldier" },
      "geometry": { "default": "geometry.bastion.humanoid" },
      "animations": {
        "look_at_target": "controller.animation.humanoid.look_at_target",
        "look_at_target_default": "animation.humanoid.look_at_target.default",
        "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
        "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
        "walk": "animation.bastion.humanoid.walk",
        "attack": "animation.bastion.humanoid.attack"
      },
      "scripts": {
        "animate": ["look_at_target", "walk", { "attack": "variable.attack_time > 0.0" }]
      },
      "render_controllers": ["controller.render.bastion.default"],
      "spawn_egg": { "base_color": "#8c1c1c", "overlay_color": "#1d1d1d" }
    }
  }
}
